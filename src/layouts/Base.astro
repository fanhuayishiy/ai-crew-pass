---
import '../styles/tokens.css';
import '../styles/deepseek.css';

interface Props {
  title: string;
  description: string;
  theme?: string;
  themeColor?: string;
  locale?: 'zh' | 'en';
  frontTexture?: string;
}

const { title, description, theme, themeColor = '#4964a0', locale = 'zh', frontTexture } = Astro.props;

// Self-hosted Geist. Absolute paths via BASE_URL keep sub-path deploys (GitHub Pages) working;
// injected with is:inline + set:html: Vite leaves this CSS alone, so there is no
// "didn't resolve at build time" warning and ${...} is never parsed as CSS.
// BASE_URL is '/hanging-pass' (**no trailing slash**) — naive concatenation gives
// '/hanging-passfonts/...' ✗ and a 404 on the fonts. Normalised here to always end with /.
const rawBase = import.meta.env.BASE_URL;
const fontBase = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const publicSite = Astro.site;
const canonical = publicSite ? new URL(Astro.url.pathname, publicSite).href : undefined;
const socialImage = publicSite ? new URL(`${fontBase}social/cover.png`, publicSite).href : undefined;
const urls = [
  { w: 400, f: 'geist-latin.woff2', range: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD' },
  { w: 500, f: 'geist-latin.woff2', range: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD' },
  { w: 600, f: 'geist-latin.woff2', range: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD' },
  { w: 400, f: 'geist-latin-ext.woff2', range: 'U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF' },
  { w: 500, f: 'geist-latin-ext.woff2', range: 'U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF' },
  { w: 600, f: 'geist-latin-ext.woff2', range: 'U+0100-024F, U+0259, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF' },
];
const fontCss = urls
  .map((u) => `@font-face{font-family:'Geist';font-style:normal;font-weight:${u.w};font-display:swap;src:url('${fontBase}fonts/${u.f}') format('woff2');unicode-range:${u.range}}`)
  .join('\n');
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'} style={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js-enabled');
      try { if (!sessionStorage.getItem('crew-first-ready')) document.documentElement.classList.add('crew-first-loading'); } catch { document.documentElement.classList.add('crew-first-loading'); }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {frontTexture && <link rel="preload" as="image" href={frontTexture} crossorigin="anonymous" fetchpriority="high" />}
        <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${fontBase}favicon.svg`} />
    <meta name="theme-color" content={themeColor} />
      <style is:inline set:html={fontCss}></style>
  </head>
  <body>
    <slot />
  </body>
</html>

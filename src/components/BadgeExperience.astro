---
import Base from '../layouts/Base.astro';
import ReactBitsBadge from './ReactBitsBadge.jsx';
import ShinyText from './react-bits/ShinyText.jsx';
import BadgeArtwork from './BadgeArtwork.astro';
import '../styles/badge-editor.css';
import { GITHUB_URL, PROJECT_GITHUB_URL, ART_SOURCE, characterStyle, mix, type Character } from '../data/characters';
import { copy, localizedCharacter, localizedCharacters, localeCharacterUrl, type Locale } from '../data/i18n';
interface Props { character: Character; locale?: Locale }
const { character: originalCharacter, locale = 'zh' } = Astro.props;
const character = localizedCharacter(originalCharacter, locale);
const characters = localizedCharacters(locale);
const ui = copy(locale);
const characterIndex = characters.findIndex(c => c.id === character.id);
const previousCharacter = characters[(characterIndex + characters.length - 1) % characters.length];
const nextCharacter = characters[(characterIndex + 1) % characters.length];

const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;
---

<Base locale={locale} frontTexture={asset(`img/badges/${locale}/${character.id}-front.webp`)} title={`${ui.siteName} · ${character.brand} · ${ui.badge}`} description={character.summary} theme={characterStyle(character)} themeColor={character.color}>
  <div class="crew-loading" data-crew-loading role="status" aria-live="polite">
    <div class="crew-loading__mark" aria-hidden="true"><span>✦</span></div>
    <p class="crew-loading__eyebrow">NONHUMAN EMPLOYEES · CREW PASS</p>
    <p class="crew-loading__title" data-loading-title>{locale === 'en' ? 'Preparing your crew pass' : '正在准备你的工牌'}</p>
    <p class="crew-loading__hint" data-loading-hint>{locale === 'en' ? 'Getting your first pass ready…' : '第一张工牌马上就好…'}</p>
    <span class="crew-loading__progress" aria-hidden="true"></span>
    <button type="button" data-loading-retry hidden>{locale === 'en' ? 'Try again' : '重新加载'}</button>
  </div>
  <main class="home-experience" id="top" data-character-id={character.id} data-locale={locale} data-chibi-front={asset(`img/badges/${locale}/${character.id}-chibi-front.webp`)} data-original-back={asset(`img/badges/${locale}/${character.id}-back.webp`)}>


    <details class="crew-picker" data-crew-picker>
      <summary aria-label={ui.switchEmployee}><span class="crew-picker__dot" aria-hidden="true"></span><span class="crew-picker__caption">{ui.switchEmployee}</span><b>{character.brand}</b><span class="crew-picker__count">09</span><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
      <nav class="character-switch crew-roster" aria-label={ui.choose}>{characters.map(c => <a href={localeCharacterUrl(c, locale)} data-texture-base={asset(`img/badges/${locale}/${c.id}`)} aria-current={c.id === character.id ? "page" : undefined} style={`--swatch:${c.color}`}><img src={asset(`img/avatars/${c.id}.webp`)} width="36" height="36" alt="" loading="lazy" decoding="async" fetchpriority="low" /><b>{c.brand}</b></a>)}</nav>
    </details>
    <section class="home-stage" id="screen1">
    <header class="home-masthead">
      <div class="station-heading"><a class="home-masthead__identity station-brand" href="#top"><span>{ui.siteName}</span></a><h1 class="collection-heading">{ui.pickup}</h1></div>
      <nav class="social-links" aria-label={locale === 'en' ? 'Links and language' : '相关链接与语言'}>
        <a class="github-star" href={PROJECT_GITHUB_URL} data-profile-github data-project-star target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z" fill="currentColor"/></svg><span>Star on GitHub</span><span aria-hidden="true">↗</span></a>
        <button type="button" class="edit-pass" data-edit-pass hidden aria-haspopup="dialog" aria-controls="badge-editor">{locale === 'en' ? 'Edit mode' : '编辑模式'}</button>
        <span class="language-switch" aria-label="Language / 语言">
          <button type="button" class="motion-toggle" data-motion-toggle hidden aria-label={locale === 'en' ? 'Enable tilt motion' : '开启手机倾斜效果'} title={locale === 'en' ? 'Enable tilt motion' : '开启手机倾斜效果'}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2M3 8l-2 2 2 2m18-4 2 2-2 2"/></svg><span>{locale === 'en' ? 'Tilt' : '倾斜'}</span></button>
          <button type="button" class="sound-toggle" data-badge-sound data-on-label={locale === 'en' ? 'Sound on · click to mute' : '声音已开启 · 点击静音'} data-off-label={locale === 'en' ? 'Sound off · click to enable' : '声音已关闭 · 点击开启'} aria-label={locale === 'en' ? 'Sound on · click to mute' : '声音已开启 · 点击静音'} aria-pressed="true" data-enabled="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4Z"/><path class="sound-waves" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/><path class="sound-muted" d="m16 9 5 6m0-6-5 6"/></svg></button>
          <a data-language="zh" lang="zh-CN" href={localeCharacterUrl(originalCharacter, 'zh')} aria-current={locale === 'zh' ? 'true' : undefined}>中文</a>
          <span aria-hidden="true">/</span>
          <a data-language="en" lang="en" href={localeCharacterUrl(originalCharacter, 'en')} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
        </span>
      </nav>
    </header>

    <p class="home-watermark" aria-hidden="true"><ShinyText client:load text={character.brand} color={mix(character.color,.80)} shineColor={mix(character.color,.57)} speed={4.5} delay={3.5} shineWidth={22} /></p>


    
    <div class="ocean-note"><p class="ocean-note__eyebrow">{character.brand.toUpperCase()} / COMMUNITY EDITION</p><p class="ocean-note__title">{character.title[0]}<br />{character.title[1]}</p><p class="ocean-note__caption">{character.caption}</p><span class="collection-stamp">AI CREW COLLECTION <i>·</i> 09 CHARACTERS</span></div><div class="employee-note"><span class="status-dot"></span> {character.name} {ui.arrived} <span>NO. {character.code}—001</span></div>
    <div class="react-bits-stage" aria-label={`${character.name} · ${ui.badge}`}>
      <div class="badge-stage-loading" role="status" aria-live="polite"><span class="badge-stage-loading__spinner" aria-hidden="true"></span><span data-stage-loading-label>{locale === 'en' ? 'Loading pass…' : '工牌加载中…'}</span><button type="button" data-stage-retry hidden>{locale === 'en' ? 'Retry' : '重试'}</button></div>
      <div class="badge-loading-preview" aria-hidden="true"><img src={asset(`img/badges/${locale}/${character.id}-front.webp`)} crossorigin="anonymous" alt="" decoding="async" fetchpriority="high" width="1296" height="1824" /></div>
      <p class="badge-back-status" data-badge-back-status role="status" aria-live="polite" hidden></p>
      <ReactBitsBadge locale={locale} client:only="react" characterId={character.id} color={character.color} cardColor={character.id === 'deepseek' ? '#e1ebfa' : mix(character.color,.87)} base={import.meta.env.BASE_URL} />
    </div>
    <div class="badge-version-switch" role="group" aria-label={locale === 'en' ? 'Pass style' : '工牌形象'}>
      <button type="button" data-badge-version="original" aria-pressed="true">{locale === 'en' ? 'Original' : '原版'}</button>
      <button type="button" data-badge-version="chibi" aria-pressed="false">{locale === 'en' ? 'Chibi' : 'Q 版'} <span aria-hidden="true">✦</span></button>
      <span class="badge-version-status" data-version-status role="status" aria-live="polite"></span>
    </div>
    <nav class="badge-controls" aria-label={ui.choose}>
    <a class="hero-role-control hero-role-control--previous" data-role-previous data-texture-base={asset(`img/badges/${locale}/${previousCharacter.id}`)} href={localeCharacterUrl(previousCharacter, locale)} aria-label={`${ui.previous} · ${previousCharacter.brand}`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>{previousCharacter.brand}</span></a>
    <a class="download-pass" href={asset(`downloads/${locale}/${character.id}-crew-pass.zip`)} download={`${character.id}-${locale}-crew-pass.zip`} data-download-pass><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{ui.download}</a>
    <button type="button" class="share-pass" data-share data-share-text="以大肥鱼的工牌做好了，快来领取！！！"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 15V3m-4 4 4-4 4 4M5 13v7h14v-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{locale === 'en' ? 'Share' : '分享'}</button>
    <span class="share-status" data-share-status role="status" aria-live="polite"></span>
    <a class="hero-role-control hero-role-control--next" data-role-next data-texture-base={asset(`img/badges/${locale}/${nextCharacter.id}`)} href={localeCharacterUrl(nextCharacter, locale)} aria-label={`${ui.next} · ${nextCharacter.brand}`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>{nextCharacter.brand}</span></a>
    </nav>
    {import.meta.env.DEV && <section class="badge-scene legacy-badge-scene" aria-hidden="true" aria-label={`${character.name}工作牌`} data-strap-label-text={character.brand.toUpperCase().replace(/[^A-Z]/g, "") || "DOUBAO"} data-strap-color={character.color} data-strap-deep={character.ink} data-strap-light={mix(character.color,.25)}>
      <BadgeArtwork character={character} locale={locale} />

    </section>}

    <footer class="home-footer">
      <div class="community-links"><button type="button" class="community-trigger" data-open-community><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M21 11c0 4.4-4 8-9 8a10 10 0 0 1-4-.8L3 20l1.4-4.1A7.1 7.1 0 0 1 3 11c0-4.4 4-8 9-8s9 3.6 9 8Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/></svg>{ui.community}</button><button type="button" class="more-about-link credits-trigger" data-open-credits>{ui.credits} <span aria-hidden="true">↗</span></button><span class="site-visits" data-visit-counter hidden title={ui.viewsHint}><span id="busuanzi_container_site_pv" style="display:none">{ui.totalViews} <span id="busuanzi_value_site_pv"></span></span></span></div>
      <a class="contact-link" href={character.chat} target="_blank" rel="noreferrer">{locale === "en" ? `${ui.chat} ${character.brand}` : `和 ${character.brand} ${ui.chat}`} <span aria-hidden="true">↗</span></a>
    <p class="interaction-hint"><span>↔</span> {ui.drag} <i>·</i> {ui.flip}</p>
    </footer>

    </section>

  <dialog class="badge-editor" id="badge-editor" data-badge-editor aria-labelledby="badge-editor-title">
    <h2 id="badge-editor-title">{locale === 'en' ? 'Edit your crew pass' : '编辑工牌'}</h2>
    <p class="badge-editor__intro">{locale === 'en' ? 'Click text on either side to replace it. Your display and downloads will use the finished pass.' : '点击正反面的文字进行替换。完成后，展示与下载都会沿用编辑结果。'}</p>
    <div class="badge-editor__layout">
      <div class="badge-editor__preview">
        <div class="badge-editor__tabs" role="group" aria-label={locale === 'en' ? 'Card side' : '工牌面'}>
          <button type="button" data-edit-side="front" aria-pressed="true">{locale === 'en' ? 'Front' : '正面'}</button>
          <button type="button" data-edit-side="back" aria-pressed="false">{locale === 'en' ? 'Back' : '背面'}</button>
        </div>
        <div class="badge-editor__viewport">
          <div class="badge-scene badge-scene--interactive texture-export badge-editor__scene" data-edit-scene>
            <template data-edit-artwork><BadgeArtwork character={character} locale={locale} /></template>
          </div>
        </div>
      </div>
      <div class="badge-editor__tools">
        <p data-edit-selection>{locale === 'en' ? 'Select text on the pass to start editing.' : '点一下卡面上的文字，就能开始替换。'}</p>
        <label for="badge-edit-text">{locale === 'en' ? 'Replacement text' : '替换文字'}</label>
        <textarea id="badge-edit-text" data-edit-text rows="4" disabled spellcheck="false"></textarea>
        <p class="badge-editor__hint">{locale === 'en' ? 'Text is saved in this browser for each employee and language. Shared links open the original pass.' : '文字按员工和语言保存在当前浏览器；分享链接打开的是原版工牌。'}</p>
        <button type="button" class="badge-editor__reset" data-edit-reset>{locale === 'en' ? 'Restore original text' : '恢复原版文字'}</button>
      </div>
    </div>
    <p class="badge-editor__status" data-edit-status role="status" aria-live="polite"></p>
    <button type="button" class="badge-editor__done" data-edit-done>{locale === 'en' ? 'Finish editing' : '完成编辑'}</button>
  </dialog>
  <dialog class="community-dialog" id="community" aria-labelledby="community-title">
    <button type="button" class="credits-close" data-close-community aria-label={ui.close}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
    <p class="community-eyebrow">FENGHUA AI LAB / WECHAT</p><h2 id="community-title">风花AI实验室</h2><p class="community-intro">{ui.communityIntro}</p>
    <img class="community-qrcode" src={asset('img/community/fenghua-ai-lab-wechat.jpg')} width="258" height="258" alt={locale === 'en' ? 'WeChat QR code for Fenghua AI Lab' : '风花AI实验室微信公众号二维码'} loading="lazy" />
    <p class="community-hint">{ui.communityHint}</p><a class="community-save" href={asset('img/community/fenghua-ai-lab-wechat.jpg')} download="fenghua-ai-lab-wechat.jpg" target="_blank" rel="noreferrer">{ui.saveQr} ↓</a>
  </dialog>
  <dialog class="download-dialog" data-download-dialog data-preparing={ui.preparing} data-hint={ui.downloadHint} data-error={ui.downloadError} aria-labelledby="download-title">
    <button type="button" class="credits-close" data-download-close aria-label={ui.close}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
    <p class="download-eyebrow">{character.brand} · {character.code}—001</p><h2 id="download-title">{ui.download}</h2>
    <p class="download-status" data-download-status aria-live="polite">{ui.downloadHint}</p>
    <div class="download-previews">{(['front','back'] as const).map(face => <figure><div class="transparency-grid"><img src={asset(`downloads/${locale}/${character.id}-${face}.png`)} loading="lazy" data-print-preview={face} alt={`${character.brand} · ${face === 'front' ? ui.front : ui.backImage}`} /></div><a data-download-face={face} href={asset(`downloads/${locale}/${character.id}-${face}.png`)} target="_blank" rel="noreferrer" download={`${character.id}-${locale}-${face}.png`}>{face === 'front' ? ui.front : ui.backImage} ↓</a></figure>)}</div>
    <a class="download-both" href={asset(`downloads/${locale}/${character.id}-crew-pass.zip`)} data-download-zip download={`${character.id}-${locale}-crew-pass.zip`}>{ui.downloadBoth} ↓</a>
    <aside class="download-support" aria-label={ui.downloadSupportTitle}>
      <div><strong>{ui.downloadSupportTitle}</strong><p>{ui.downloadSupportText}</p></div>
      <a href={PROJECT_GITHUB_URL} data-download-star target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z" fill="currentColor"/></svg>{ui.downloadSupportAction}<span aria-hidden="true">↗</span></a>
    </aside>
  </dialog>
  <dialog class="artwork-note" id="credits" aria-labelledby="credits-title"><button type="button" class="credits-close" data-close-credits aria-label={ui.close}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button><h2 id="credits-title">{ui.credits}</h2><p>AI CREW PASS · COMMUNITY FAN ART</p><p>{ui.credit}</p><p>{ui.rights} <a href={ART_SOURCE} target="_blank" rel="noreferrer">{ui.original} ↗</a> · <a href={asset(locale === "en" ? "img/characters/NOTICE.en.md" : "img/characters/NOTICE.md")}>{ui.notice}</a> · {ui.galleryBy} <a href="https://github.com/xu-yaoting/hanging-pass" target="_blank" rel="noreferrer">Hanging Pass</a> · {ui.physicsBy}: <a href="https://github.com/DavidHDev/react-bits" target="_blank" rel="noreferrer">React Bits Lanyard</a> · <a href={GITHUB_URL} target="_blank" rel="noreferrer">fanhuayishiy ↗</a></p></dialog>
  </main>

  <script>

    import { initPageEnhancements } from '../scripts/page-enhancements';
    initPageEnhancements();
    import { initBadgeDownload } from '../scripts/badge-download';
    initBadgeDownload();
    import { initBadgeEditor } from '../scripts/badge-editor';
    initBadgeEditor();
  </script>
</Base>
